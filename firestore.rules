rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && me().role == 'admin';
    }

    function isTeacher() {
      return signedIn() && me().role == 'teacher';
    }

    function sameClass(classId) {
      return isTeacher() && me().classId == classId;
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if isAdmin();
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /classes/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /students/{id} {
      allow read: if isAdmin() || sameClass(resource.data.classId);
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /teachers/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /attendance/{id} {
      allow read: if isAdmin() || sameClass(resource.data.classId);
      allow create: if isAdmin() || sameClass(request.resource.data.classId);
      allow update, delete: if isAdmin();
    }
  }
}
